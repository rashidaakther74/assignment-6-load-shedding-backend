{
  "version": 2,
  "builds": [
    {
      "src": "dist/src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/src/app.js"
    }
  ],
  "functions": {
    "dist/src/app.js": {
      "includeFiles": "node_modules/.prisma/client/**/*"
    }
  }
}
