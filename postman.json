{
  "info": {
    "_postman_id": "a1b2c3d4-0001-4e5f-9a8b-loadshedding01",
    "name": "Load Shedding Power Management API",
    "description": "REST API collection for the Load Shedding Power Management System (Express + TypeScript + Prisma/PostgreSQL).\n\n**Base URL:** `{{base_url}}` (default: http://localhost:5000)\n\n**Auth:** Login via `Auth > Login` — the returned `accessToken` is automatically saved to the `{{token}}` collection variable and used as a Bearer token for all protected routes.\n\n**Roles:** `ADMIN`, `OPERATOR`, `CONSUMER`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "area_id",
      "value": ""
    },
    {
      "key": "schedule_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test Consumer\",\n    \"email\": \"consumer@example.com\",\n    \"password\": \"password123\",\n    \"phone\": \"01700000000\",\n    \"role\": \"CONSUMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new user. `role` is optional (default: `CONSUMER`). Allowed roles: `ADMIN`, `OPERATOR`, `CONSUMER`."
          },
          "response": []
        },
        {
          "name": "Register Admin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"System Admin\",\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\",\n    \"phone\": \"01800000000\",\n    \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register an ADMIN user (needed for admin-only routes)."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"token\", res.data.accessToken);",
                  "    console.log(\"Token saved to {{token}}\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login with email & password. The returned `accessToken` is automatically stored in the `{{token}}` collection variable for all authenticated requests."
          },
          "response": []
        }
      ]
    },
